---
// Lazy Google Maps embed with a plain directions link (works even if the iframe is blocked).
// Requires frame-src https://www.google.com in vercel.json (already allowed).
interface Props {
  /** Address or business name + city, exactly as on Google Maps */
  query: string;
  title: string;
}

const { query, title } = Astro.props;
const encoded = encodeURIComponent(query);
---

<div>
  <iframe
    src={`https://www.google.com/maps?q=${encoded}&output=embed`}
    title={title}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="aspect-[4/3] w-full rounded-card border border-line"></iframe>
  <p class="mt-3">
    <a class="btn btn-secondary" href={`https://www.google.com/maps/dir/?api=1&destination=${encoded}`}>
      Get directions
    </a>
  </p>
</div>
