---
interface Props {
  items: { question: string; answer: string }[];
  heading?: string;
  /** Tinted background; the homepage alternates it between sections */
  surface?: boolean;
}

const { items, heading = 'Questions customers ask', surface = false } = Astro.props;
---

{
  items.length > 0 && (
    <section class:list={['section', { 'bg-surface': surface }]} aria-labelledby="faq-title">
      <div class="wrap">
        <h2 id="faq-title">{heading}</h2>
        <div class="faq mt-8 max-w-3xl border-t-2 border-text">
          {items.map((item) => (
            <details class="border-b border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-xl font-semibold leading-snug">
                {item.question}
              </summary>
              <p class="max-w-2xl pb-5 text-muted">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    flex: none;
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1;
    color: var(--color-brand);
    transition: transform 0.2s ease;
  }
  .faq details[open] summary::after {
    transform: rotate(45deg);
  }
</style>
