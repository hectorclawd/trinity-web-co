---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../content/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
---

<BaseLayout title="Blog" description={`Tips and answers from ${site.name}.`} noindex={posts.length === 0}>
  <section class="section">
    <div class="wrap">
      <h1>Blog</h1>
      {
        posts.length === 0 ? (
          <p class="mt-5 text-muted">No posts yet.</p>
        ) : (
          <ul class="mt-8 max-w-3xl space-y-8">
            {posts.map((post) => (
              <li class="border-t border-line pt-6">
                <h2 class="text-2xl">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="mt-1 text-base text-muted">
                  <time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
                </p>
                <p class="mt-2">{post.data.description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
