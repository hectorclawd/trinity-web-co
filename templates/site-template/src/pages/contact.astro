---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import HoursList from '../components/HoursList.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { site } from '../content/site';
import { fullAddress } from '../lib/format';

const address = fullAddress(site);
const fallback = site.phone ? `call ${site.phone.display}` : `email ${site.email}`;
---

<BaseLayout title="Contact" description={`Contact ${site.name}${site.phone ? ` at ${site.phone.display}` : ''}, or send a message and we’ll reply within one business day.`}>
  <section class="section">
    <div class="wrap grid items-start gap-10 md:grid-cols-[1fr_1.2fr] md:gap-16">
      <div>
        <h1>{site.features.quoteForm ? 'Get a free quote' : 'Contact us'}</h1>
        <p class="mt-5 max-w-md">Tell us what you need and we’ll get back to you within one business day.</p>
        <ul class="mt-6 space-y-2">
          {
            site.phone && (
              <li>
                Call{' '}
                <a href={`tel:${site.phone.e164}`}>{site.phone.display}</a>
              </li>
            )
          }
          {
            site.phone?.textable && (
              <li>
                Text{' '}
                <a href={`sms:${site.phone.e164}`}>{site.phone.display}</a>
              </li>
            )
          }
          <li>
            Email{' '}
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          {address && !site.serviceAreaOnly && <li>{address}</li>}
        </ul>
        <h2 class="mt-10 text-2xl">Hours</h2>
        <div class="mt-3"><HoursList hours={site.hours} /></div>
      </div>
      <ContactForm
        endpoint={site.forms.contactEndpoint}
        variant={site.features.quoteForm ? 'quote' : 'contact'}
        jobTypes={site.forms.quoteJobTypes}
        submitLabel={site.features.quoteForm ? 'Request my quote' : 'Send message'}
        fallback={fallback}
      />
    </div>
  </section>

  {
    site.features.map && address && !site.serviceAreaOnly && (
      <section class="pb-16">
        <div class="wrap">
          <MapEmbed query={`${site.name}, ${address}`} title={`Map to ${site.name}`} />
        </div>
      </section>
    )
  }
</BaseLayout>
