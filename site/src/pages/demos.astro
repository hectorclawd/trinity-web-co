---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, offer } from '../content/site';

const { demos } = offer;
---

<BaseLayout title="Demo sites" description="Two demo websites built for made-up Dallas businesses, both scoring 100 on mobile PageSpeed.">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">{demos.heading}</span>
      <h1>See the work before you hire me</h1>
      <p class="lede">{demos.lede}</p>
    </div>
  </section>

  <section class="section tint" aria-label="Demo sites">
    <div class="wrap demos">
      {
        demos.slots.map((slot, i) => (
          <article class="demo" data-reveal style={`--d:${i}`}>
            <div class="frame">
              <span class="tag">Demo</span>
              {slot.image && (
                <div class="scroll-frame" tabindex="0" role="region" aria-label={`${slot.title} homepage, scrollable`}>
                  <Image src={slot.image} widths={[600, 1000]} sizes="(max-width: 800px) 100vw, 560px" alt={slot.imageAlt ?? ''} loading="lazy" />
                </div>
              )}
            </div>
            <div class="demo-body">
              <div>
                <h2 style="font-size:1.3rem">{slot.title.replace(/^Demo: /, '')}</h2>
                <small>{slot.niche} demo</small>
              </div>
              {slot.pageSpeed && <span class="score">PageSpeed {slot.pageSpeed}</span>}
              {slot.url && (
                <a class="btn btn-line light" style="width:100%" href={slot.url} target="_blank" rel="noopener">
                  Open the live demo
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section ink" aria-labelledby="both-title">
    <div class="wrap">
      <div class="head-row">
        <div>
          <span class="eyebrow">What's in both</span>
          <h2 id="both-title">The same care goes into every site</h2>
        </div>
      </div>
      <ul class="steps">
        <li class="step" data-reveal style="--d:0">
          <h3>Call and text on every page</h3>
          <p>The phone number is one tap away, at the top and in a bar that follows you on phones.</p>
        </li>
        <li class="step" data-reveal style="--d:1">
          <h3>Fast everywhere</h3>
          <p>Both demos score 100 on mobile PageSpeed and open in about a second.</p>
        </li>
        <li class="step" data-reveal style="--d:2">
          <h3>Real local details</h3>
          <p>Hours, service areas and neighborhoods written for Dallas customers, not filler text.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section cta-band" aria-labelledby="cta-title">
    <div class="wrap">
      <h2 id="cta-title">Want one like this for your business?</h2>
      <p>{site.cta.heading}. {site.cta.text}</p>
      <div class="actions"><a class="btn btn-gold" href={site.cta.button.href}>{site.cta.button.label}</a></div>
      <p class="cta-note">{offer.reassurance.price} {offer.reassurance.care}</p>
    </div>
  </section>
</BaseLayout>
