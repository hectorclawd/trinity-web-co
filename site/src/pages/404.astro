---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
---

<BaseLayout title="Page not found" noindex>
  <section class="page-head">
    <div class="wrap">
      <h1>This page doesn’t exist</h1>
      <p class="lede">The link may be old, or the address may have a typo.</p>
      <p class="actions">
        <a class="btn btn-gold" href="/">Go to the homepage</a>
        {site.phone && <a class="btn btn-line" href={`tel:${site.phone.e164}`}>Call {site.phone.display}</a>}
      </p>
    </div>
  </section>
</BaseLayout>
