---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import RiverHero from '../components/site/RiverHero.astro';
import Features from '../components/site/Features.astro';
import Niches from '../components/site/Niches.astro';
import Packages from '../components/site/Packages.astro';
import CarePlans from '../components/site/CarePlans.astro';
import DemoSlots from '../components/site/DemoSlots.astro';
import Process from '../components/site/Process.astro';
import About from '../components/site/About.astro';
import ProjectReadiness from '../components/site/ProjectReadiness.astro';
import BookBar from '../components/site/BookBar.astro';
import CurrentSection from '../components/site/CurrentSection.astro';
import { site, offer } from '../content/site';

// Extra contact form fields, styled like the ones inside ContactForm
const fieldClass =
  'w-full rounded-btn border-[1.5px] border-muted bg-white px-3.5 py-3 text-[1.0625rem] text-text aria-[invalid=true]:border-error';
const labelClass = 'mb-1.5 block text-base font-semibold';
// Formspree joins checked boxes that share a name into one comma-separated value
const goals = ['Call or text', 'Book online', 'Ask for a quote', 'Visit in person'];
---

<BaseLayout>
  <RiverHero />
  <Features />
  <Niches />

  <section id="pricing" class="section" aria-labelledby="pricing-title">
    <div class="wrap">
      <h2 id="pricing-title">{offer.pricing.heading}</h2>
      <p class="section-lede">{offer.pricing.lede}</p>
      <Packages />
      <CarePlans />
      <div class="mt-14">
        <CTABand id="founding" variant="accent" {...offer.founding} />
      </div>
    </div>
  </section>

  <DemoSlots />
  <Process />
  <About />

  <div class="bg-surface">
    <FAQ items={site.faqs} heading="Questions owners ask" />
  </div>

  <ProjectReadiness />

  <section id="contact" class="section" aria-labelledby="contact-title" data-book-cta>
    <div class="wrap grid items-start gap-12 md:grid-cols-[1fr_1.15fr] md:gap-20">
      <div>
        <h2 id="contact-title">{offer.contact.heading}</h2>
        <p class="mt-5 max-w-md">{offer.contact.text}</p>
        <p class="mt-5 max-w-md font-semibold">
          Prefer email?{' '}
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="mt-5 max-w-md text-base text-muted">{offer.contact.area}</p>
      </div>
      <ContactForm
        endpoint={site.forms.contactEndpoint}
        businessField
        messageLabel="What do you need help with?"
        submitLabel="Send my request"
        successMessage="Request sent. I’ll reply within one business day."
        fallback={`email ${site.email}`}
        surface
      >
        <div class="mb-4">
          <label class={labelClass} for="cf-current-site">
            Current website{' '}<span class="font-normal text-muted">(if you have one)</span>
          </label>
          <input
            class={fieldClass}
            id="cf-current-site"
            name="current_site"
            type="text"
            inputmode="url"
            placeholder="yourbusiness.com"
          />
        </div>
        <fieldset class="mb-4">
          <legend class={labelClass}>
            What should your site get customers to do?{' '}<span class="font-normal text-muted">(optional)</span>
          </legend>
          <div class="grid gap-x-6 sm:grid-cols-2">
            {
              goals.map((goal, index) => (
                <label class="flex min-h-11 cursor-pointer items-center gap-3" for={`cf-goal-${index}`}>
                  <input class="size-5 flex-none accent-brand" id={`cf-goal-${index}`} name="goal" type="checkbox" value={goal} />
                  {goal}
                </label>
              ))
            }
          </div>
        </fieldset>
        <div class="mb-4">
          <label class={labelClass} for="cf-timing">
            When would you like it live?{' '}<span class="font-normal text-muted">(optional)</span>
          </label>
          <input class={fieldClass} id="cf-timing" name="timing" type="text" />
        </div>
      </ContactForm>
    </div>
  </section>

  <BookBar />
  <CurrentSection />
</BaseLayout>
