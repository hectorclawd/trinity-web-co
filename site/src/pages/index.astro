---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import RiverHero from '../components/site/RiverHero.astro';
import Icon, { type IconName } from '../components/site/Icon.astro';
import demoPurpleMartinTop from '../assets/demo-purple-martin-top.jpg';
import demoGoodOakTop from '../assets/demo-good-oak-top.jpg';
import { site, offer } from '../content/site';

const featureIcons: IconName[] = ['search', 'phone', 'call', 'bolt', 'key', 'shield'];
const launch = offer.pricing.packages.find((pkg) => pkg.name === 'Launch');
const lowestScore = Math.min(...offer.demos.slots.map((slot) => slot.pageSpeed ?? 0));
// The homepage cards show the top of each demo; the demos page shows the whole homepage
const demoTops = [demoPurpleMartinTop, demoGoodOakTop];
---

<BaseLayout>
  <RiverHero />

  <section class="trust" aria-label="At a glance">
    <div class="wrap trust-grid">
      <div class="trust-item">
        <span class="trust-num" data-count={lowestScore}>{lowestScore}</span>
        <span class="trust-label">Mobile PageSpeed score on both demo sites</span>
      </div>
      <div class="trust-item"><span class="trust-num">1 day</span><span class="trust-label">Replies within one business day</span></div>
      {
        launch && (
          <div class="trust-item">
            <span class="trust-num">{launch.price.replace(/^From /, '')}</span>
            <span class="trust-label">Launch websites start at, price in writing</span>
          </div>
        )
      }
      <div class="trust-item"><span class="trust-num">Yours</span><span class="trust-label">Your domain and content stay in your name</span></div>
    </div>
  </section>

  <section class="section tint" aria-labelledby="features-title">
    <div class="wrap">
      <div class="head-row">
        <div>
          <span class="eyebrow">What you get</span>
          <h2 id="features-title">{offer.features.heading}</h2>
          <p class="lede">{offer.features.lede}</p>
        </div>
        <a class="btn btn-line light" href="/services/">Packages and pricing</a>
      </div>
      <div class="grid-3">
        {
          offer.features.items.map((item, i) => (
            <article class="card" data-reveal style={`--d:${i % 3}`}>
              <span class="icon"><Icon name={featureIcons[i % featureIcons.length]} /></span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section ink" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="head-row">
        <div>
          <span class="eyebrow">How it works</span>
          <h2 id="steps-title">Three steps from first call to live site</h2>
        </div>
        <a class="btn btn-line" href="/contact/">All five steps</a>
      </div>
      <ol class="steps">
        <li class="step" data-reveal style="--d:0">
          <h3>Free 20-minute call</h3>
          <p>On the phone or over coffee. You tell me about the business and what's not working.</p>
        </li>
        <li class="step" data-reveal style="--d:1">
          <h3>Your price in writing</h3>
          <p>Within 24 hours you get your exact price, a timeline and a list of what I'll need. You pay half to hold your spot.</p>
        </li>
        <li class="step" data-reveal style="--d:2">
          <h3>Preview, then launch</h3>
          <p>You check a preview link on your phone, I make your changes, and the site goes live on your domain.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="demos-title">
    <div class="wrap">
      <div class="head-row">
        <div>
          <span class="eyebrow">Demo sites</span>
          <h2 id="demos-title">See the work before you hire me</h2>
          <p class="lede">Two sites built for made-up businesses. Each one is labeled as a demo.</p>
        </div>
        <a class="btn btn-line light" href="/demos/">Scroll through both</a>
      </div>
      <div class="demos">
        {
          offer.demos.slots.map((slot, i) => (
            <a class="demo" data-reveal style={`--d:${i}`} href={slot.url} target="_blank" rel="noopener">
              <div class="demo-shot">
                <span class="tag">Demo</span>
                <Image src={demoTops[i]} widths={[600, 900, 1200]} sizes="(max-width: 800px) 100vw, 560px" alt={slot.imageAlt ?? ''} loading="lazy" />
              </div>
              <div class="demo-body">
                <div>
                  <h3>{slot.title.replace(/^Demo: /, '')}</h3>
                  <small>{slot.niche} demo</small>
                </div>
                {slot.pageSpeed && <span class="score">PageSpeed {slot.pageSpeed}</span>}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section tint" aria-labelledby="about-title">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Why Trinity</span>
        <h2 id="about-title">{site.about.heading}</h2>
        <ul class="checks">{offer.promises.map((promise) => <li>{promise}</li>)}</ul>
        <ul class="pills" aria-label={offer.niches.heading}>{offer.niches.items.map((niche) => <li class="pill">{niche}</li>)}</ul>
      </div>
      <div class="note-card" data-reveal>
        {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p class="sig">Hector, {site.name}</p>
      </div>
    </div>
  </section>

  <section class="section cta-band" aria-labelledby="cta-title">
    <div class="wrap">
      <h2 id="cta-title">Book a free <span class="nowrap">20-minute</span> call</h2>
      <p>{site.cta.text} In English or Spanish, by phone, video or over coffee.</p>
      <div class="actions">
        <a class="btn btn-gold" href={site.cta.button.href}>{site.cta.button.label}</a>
        {site.phone?.textable && <a class="btn btn-line" href={`sms:${site.phone.e164}`}>Text {site.phone.display}</a>}
      </div>
    </div>
  </section>
</BaseLayout>
