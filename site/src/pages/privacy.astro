---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
---

<BaseLayout title="Privacy" description="How Trinity Web Co. handles the information you send through this website.">
  <section class="section">
    <div class="wrap prose-basic max-w-3xl">
      <h1 class="text-[length:var(--step-3)]">Privacy</h1>
      <p class="text-muted">Last updated October 7, 2026.</p>

      <h2>What I collect</h2>
      <p>
        If you fill out the contact form, I receive the details you enter: your name, business name, email, phone number
        (if given), website and message. The form is processed by Formspree, which delivers it to my inbox.
      </p>

      <h2>How I use it</h2>
      <p>Only to reply to you about your project. I don’t sell or share your information, and I don’t add you to a mailing list.</p>

      <h2>Analytics</h2>
      <p>
        This site uses Vercel Web Analytics to count visits. It doesn’t use cookies and doesn’t identify you personally.
        Fonts are served from this site, not from Google or another third party.
      </p>

      <h2>Deleting your information</h2>
      <p>
        Email{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>
        , and I’ll delete your messages and contact details.
      </p>

      <p><a href="/">Back to the homepage</a></p>
    </div>
  </section>
</BaseLayout>
