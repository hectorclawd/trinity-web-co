---
import type { Link } from '../content/types';

interface Props {
  heading: string;
  text?: string;
  button: Link;
  /** "brand": dark band. "accent": accent-colored panel, e.g. for an offer */
  variant?: 'brand' | 'accent';
  id?: string;
}

const { heading, text, button, variant = 'brand', id } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

{
  variant === 'brand' ? (
    <section id={id} class="bg-brand py-14 text-white" aria-labelledby={headingId}>
      <div class="wrap flex flex-wrap items-center justify-between gap-6">
        <div class="max-w-2xl">
          <h2 id={headingId} class="text-white">{heading}</h2>
          {text && <p class="mt-3 text-white/85">{text}</p>}
          <slot />
        </div>
        <a class="btn btn-primary btn-arrow" href={button.href}>{button.label}</a>
      </div>
    </section>
  ) : (
    <aside
      id={id}
      class="grid items-center gap-x-10 gap-y-4 rounded-card bg-accent p-6 text-on-accent sm:p-10 md:grid-cols-[1fr_auto]"
      aria-labelledby={headingId}
    >
      <div>
        <h3 id={headingId} class="text-[1.75rem] text-on-accent">{heading}</h3>
        {text && <p class="mt-3 max-w-3xl">{text}</p>}
        <slot />
      </div>
      <a class="btn btn-dark btn-arrow justify-self-start" href={button.href}>{button.label}</a>
    </aside>
  )
}
