---
import SpotlightCard from './SpotlightCard.astro';

const items = [
  'A list of your services, with the 2 or 3 you most want customers to notice',
  'The cities or neighborhoods you serve and your usual business hours',
  'Your logo and brand colors, if you have them',
  'A few photos of your work, team, or place of business',
  'Customer reviews you have permission to share, if any',
  'A couple of websites you like and what you like about them',
  'Your current website address, if you have one',
];
---

<section class="section" aria-labelledby="readiness-title">
  <div class="wrap readiness-layout">
    <div class="readiness-intro">
      <h2 id="readiness-title">A few things that help us get started</h2>
      <p>
        Use this as a reminder, not a test. You can contact me even if you don’t have everything ready;
        we’ll figure out the next step together.
      </p>
      <p class="readiness-note">Please don’t share passwords or account logins here.</p>
    </div>

    <SpotlightCard>
      <fieldset class="readiness-card" data-readiness>
        <legend class="sr-only">Optional project-readiness checklist</legend>
        <div class="readiness-progress-wrap" data-progress-wrap hidden>
          <div class="readiness-progress-heading">
            <span>Checklist progress</span>
            <span data-progress-count role="status" aria-live="polite" aria-atomic="true">0 of {items.length} checked</span>
          </div>
          <progress
            class="readiness-progress"
            max={items.length}
            value="0"
            aria-label="Checklist items checked"
            data-readiness-progress
          >
            0
          </progress>
        <p class="readiness-saved-note">These checks aren’t sent or saved.</p>
        </div>
        <ul class="readiness-list">
          {items.map((item, index) => (
            <li>
              <label for={`readiness-${index}`}>
                <input id={`readiness-${index}`} type="checkbox" />
                <span>{item}</span>
              </label>
            </li>
          ))}
        </ul>
      </fieldset>
    </SpotlightCard>
  </div>
</section>

<style>
  .readiness-layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  .readiness-intro > p {
    max-width: 38rem;
    margin-top: 1rem;
    color: var(--color-muted);
  }
  .readiness-intro .readiness-note {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .readiness-card {
    min-width: 0;
    margin: 0;
    padding: 1.5rem;
    border: 0;
    border-radius: var(--radius-card);
    background: transparent;
  }
  .readiness-progress-wrap {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
  }
  .readiness-progress-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: 1rem;
    font-weight: 650;
  }
  .readiness-progress-heading [data-progress-count] {
    color: var(--color-brand-dark);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .readiness-progress {
    display: block;
    width: 100%;
    height: 0.65rem;
    margin-top: 0.65rem;
    overflow: hidden;
    border: 0;
    border-radius: 999px;
    background: var(--color-line);
    accent-color: var(--color-brand);
  }
  .readiness-progress::-webkit-progress-bar {
    border-radius: 999px;
    background: var(--color-line);
  }
  .readiness-progress::-webkit-progress-value {
    border-radius: 999px;
    background: var(--color-brand);
  }
  .readiness-progress::-moz-progress-bar {
    border-radius: 999px;
    background: var(--color-brand);
  }
  .readiness-saved-note {
    margin-top: 0.45rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .readiness-list {
    display: grid;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .readiness-list label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.65rem 0;
    cursor: pointer;
  }
  .readiness-list input {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    margin-top: 0.2rem;
    accent-color: var(--color-brand);
  }

  @media (min-width: 48rem) {
    .readiness-layout {
      grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.2fr);
      gap: 3rem;
    }
  }

  @media (min-width: 72rem) {
    .readiness-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  const checklist = document.querySelector<HTMLElement>('[data-readiness]');

  if (checklist) {
    const checkboxes = [...checklist.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const progress = checklist.querySelector<HTMLProgressElement>('[data-readiness-progress]');
    const count = checklist.querySelector<HTMLElement>('[data-progress-count]');
    const progressWrap = checklist.querySelector<HTMLElement>('[data-progress-wrap]');

    if (progress && count && progressWrap) {
      const updateProgress = () => {
        const checked = checkboxes.filter((checkbox) => checkbox.checked).length;
        progress.value = checked;
        count.textContent = `${checked} of ${checkboxes.length} checked`;
      };

      checkboxes.forEach((checkbox) => checkbox.addEventListener('change', updateProgress));
      updateProgress();
      progressWrap.hidden = false;
    }
  }
</script>
