---
// The client process is a real sequence, so the steps are numbered and joined by a
// river-green connector. Every step is plain HTML; the connector's draw-in is CSS only.
import { offer } from '../../content/site';
import BuildClip from './BuildClip.astro';

const { heading, steps } = offer.process;
---

<section id="process" class="section process" aria-labelledby="process-title">
  <div class="wrap">
    <h2 id="process-title">{heading}</h2>
    <div class="process-body">
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <BuildClip />
    </div>
  </div>
</section>

<style>
  .process {
    background: var(--color-surface);
  }
  .steps {
    --marker: 2.6rem;
    --connector: color-mix(in srgb, var(--color-brand) 55%, var(--color-surface));
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    position: relative;
    counter-increment: step;
    view-timeline: --step;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--marker);
    height: var(--marker);
    border: 2px solid var(--color-brand);
    border-radius: 50%;
    background: var(--color-surface);
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    color: var(--color-brand-dark);
  }
  /* The connector runs from one marker to the next, with a little air on each side */
  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    background: var(--connector);
  }
  .steps p {
    margin-top: 0.5rem;
    font-size: 1rem;
    color: var(--color-muted);
  }

  /* High contrast mode wipes background colors, so draw the connector in the text color */
  @media (forced-colors: active) {
    .steps li:not(:last-child)::after {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }

  /* A vertical timeline at every width, so no column gets cramped */
  .steps {
    max-width: 48rem;
  }
  .steps li {
    padding: 0 0 2.25rem calc(var(--marker) + 1.4rem);
  }
  .steps li:last-child {
    padding-bottom: 0;
  }
  .steps li:not(:last-child)::after {
    --connect-from: scaleY(0);
    top: calc(var(--marker) + 0.4rem);
    bottom: 0.4rem;
    left: calc(var(--marker) / 2 - 1px);
    width: 2px;
    transform-origin: center top;
  }
  .steps h3 {
    padding-top: 0.45rem;
  }

  /* Wide screens: the steps on the left, the build clip beside them (BuildClip.astro keeps it
     in view); more room between steps gives the clip scroll to play through */
  @media (min-width: 68rem) {
    .process-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: start;
      column-gap: 4rem;
      margin-top: 3rem;
    }
    .process-body .steps {
      margin-top: 0;
    }
    .steps li {
      padding-bottom: 3.5rem;
    }
  }

  /* Tablets and up: title beside its text, to use the width without stretching lines */
  @media (min-width: 44rem) {
    .steps li {
      display: grid;
      grid-template-columns: minmax(10rem, 13rem) 1fr;
      column-gap: 2rem;
    }
    .steps p {
      margin-top: 0;
      padding-top: 0.55rem;
    }
  }

  /* The connector draws in as each step scrolls into view. Browsers without scroll-driven
     animations, and anyone who prefers reduced motion, see it fully drawn. The timeline sits
     in its own rule: in one rule, the CSS minifier folds animation-timeline into the animation
     shorthand, which browsers reject, and the line never animates. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .steps li:not(:last-child)::after {
        animation: step-connect linear both;
      }
      .steps > li:not(:last-child)::after {
        animation-timeline: --step;
        animation-range: entry 40% entry 100%;
      }
    }
  }
  @keyframes step-connect {
    from {
      transform: var(--connect-from);
    }
  }
</style>
