---
// The client process is a real sequence, so the steps are numbered and joined by a
// river-green connector. Every step is plain HTML; the connector's draw-in is CSS only.
import { offer } from '../../content/site';

const { heading, steps } = offer.process;
---

<section id="process" class="section process" aria-labelledby="process-title">
  <div class="wrap">
    <h2 id="process-title">{heading}</h2>
    <ol class="steps">
      {
        steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--color-surface);
  }
  .steps {
    --marker: 2.6rem;
    --connector: color-mix(in srgb, var(--color-brand) 55%, var(--color-surface));
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    position: relative;
    counter-increment: step;
    view-timeline: --step;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--marker);
    height: var(--marker);
    border: 2px solid var(--color-brand);
    border-radius: 50%;
    background: var(--color-surface);
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    color: var(--color-brand-dark);
  }
  /* The connector runs from one marker to the next, with a little air on each side */
  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    background: var(--connector);
  }
  .steps p {
    margin-top: 0.5rem;
    font-size: 1rem;
    color: var(--color-muted);
  }

  /* Wide screens: one row of five steps with a horizontal connector */
  @media (min-width: 68rem) {
    .steps {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 2rem;
    }
    .steps li {
      padding-top: 3.75rem;
    }
    .steps li:not(:last-child)::after {
      --connect-from: scaleX(0);
      top: calc(var(--marker) / 2 - 1px);
      left: calc(var(--marker) + 0.5rem);
      right: calc(-2rem + 0.5rem);
      height: 2px;
      transform-origin: left center;
    }
  }

  /* Narrower screens: a vertical timeline, so no column gets cramped */
  @media (max-width: 67.99rem) {
    .steps {
      max-width: 48rem;
    }
    .steps li {
      padding: 0 0 2.25rem calc(var(--marker) + 1.4rem);
    }
    .steps li:last-child {
      padding-bottom: 0;
    }
    .steps li:not(:last-child)::after {
      --connect-from: scaleY(0);
      top: calc(var(--marker) + 0.4rem);
      bottom: 0.4rem;
      left: calc(var(--marker) / 2 - 1px);
      width: 2px;
      transform-origin: center top;
    }
    .steps h3 {
      padding-top: 0.45rem;
    }
  }

  /* Tablets: title beside its text, to use the width without stretching lines */
  @media (min-width: 44rem) and (max-width: 67.99rem) {
    .steps li {
      display: grid;
      grid-template-columns: minmax(10rem, 13rem) 1fr;
      column-gap: 2rem;
    }
    .steps p {
      margin-top: 0;
      padding-top: 0.55rem;
    }
  }

  /* The connector draws in as each step scrolls into view. Browsers without scroll-driven
     animations, and anyone who prefers reduced motion, see it fully drawn. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .steps li:not(:last-child)::after {
        animation: step-connect linear both;
        animation-timeline: --step;
        animation-range: entry 40% entry 100%;
      }
    }
  }
  @keyframes step-connect {
    from {
      transform: var(--connect-from);
    }
  }
</style>
