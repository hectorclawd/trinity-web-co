---
// "Book a free call" pinned to the bottom of the screen on phones and tablets (below 1024px,
// where the header's button is tucked inside the menu). Adapted from the client template's
// CallBar, with one button (the phone number sits in the contact section and footer):
// - Hidden while any [data-book-cta] block is on screen (the hero buttons, the contact
//   section), so the page never shows the same button twice.
// - Hidden while a form field has focus, so it can't float over the field above the keyboard.
// - The footer gets extra bottom padding the bar's height, so the bar never covers it and the
//   reserved space is footer-colored rather than a bare strip under it.
// - Starts hidden so it doesn't flash over the hero on load. Without JavaScript it stays visible.
import { site } from '../../content/site';

const cta = site.headerCta;
---

{
  cta && (
    <div class="book-bar is-hidden" data-book-bar>
      <a class="btn btn-primary" href={cta.href}>
        {cta.label}
      </a>
    </div>
  )
}

<noscript>
  <style is:inline>
    [data-book-bar] { transform: none !important; visibility: visible !important; }
  </style>
</noscript>

<style>
  .book-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: flex;
    padding: 0.75rem clamp(1rem, 4vw, 2.5rem) max(0.75rem, env(safe-area-inset-bottom));
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
    box-shadow: 0 -0.25rem 1rem rgb(0 0 0 / 0.08);
    transition: transform 0.2s, visibility 0.2s;
  }
  .book-bar > .btn {
    flex: 1;
  }
  .book-bar.is-hidden {
    transform: translateY(100%);
    visibility: hidden;
  }
  @media (max-width: 63.99rem) {
    /* 3rem is the footer's own bottom padding (py-12) */
    :global(body > footer) {
      padding-bottom: calc(3rem + 4.5rem + 1px + max(0rem, env(safe-area-inset-bottom) - 0.75rem));
    }
    :global(html) {
      scroll-padding-bottom: 5.5rem;
    }
  }
  @media (min-width: 64rem) {
    .book-bar {
      display: none;
    }
  }
  @media print {
    .book-bar {
      display: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-book-bar]');

  if (bar) {
    const ctasOnScreen = new Set<Element>();
    let fieldFocused = false;
    const update = () => bar.classList.toggle('is-hidden', ctasOnScreen.size > 0 || fieldFocused);

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) ctasOnScreen.add(entry.target);
        else ctasOnScreen.delete(entry.target);
      }
      update();
    });
    const ctas = document.querySelectorAll('[data-book-cta]');
    ctas.forEach((el) => observer.observe(el));
    // With nothing to watch, show it now; otherwise the observer's first report decides
    if (ctas.length === 0) update();

    const isField = (el: EventTarget | null) => el instanceof Element && el.matches('input, select, textarea');
    document.addEventListener('focusin', (event) => {
      fieldFocused = isField(event.target);
      update();
    });
    document.addEventListener('focusout', () => {
      fieldFocused = false;
      update();
    });
  }
</script>
