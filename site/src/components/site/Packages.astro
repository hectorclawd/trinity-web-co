---
// Website packages as rows, not cards. Prices come from offer.pricing in site.ts,
// which must match business/playbook.md section 2.
import { offer } from '../../content/site';

const { packages, note } = offer.pricing;
---

<div class="plans">
  {
    packages.map((pkg) => (
      <article class:list={['plan', { 'plan-featured': pkg.featured }]}>
        <header>
          <h3 class="plan-name">{pkg.name}</h3>
          <p class="plan-price">{pkg.price}</p>
          <p class="plan-time">{pkg.turnaround}</p>
        </header>
        <div>
          <p class="plan-for">{pkg.bestFor}</p>
          <ul class="plan-list">
            {pkg.includes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }
</div>
<p class="plans-note">{note}</p>

<style>
  .plans {
    margin-top: 3rem;
    border-top: 2px solid var(--color-text);
  }
  .plan {
    display: grid;
    grid-template-columns: minmax(14rem, 18rem) 1fr;
    gap: 1rem 3rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .plan-featured {
    margin-inline: calc(clamp(1rem, 4vw, 2.5rem) * -0.5);
    padding-inline: calc(clamp(1rem, 4vw, 2.5rem) * 0.5);
    background: var(--color-surface);
    border-bottom-color: transparent;
    box-shadow: inset 4px 0 0 var(--color-brand);
  }
  .plan-name {
    font-size: var(--step-2);
    font-weight: 800;
    font-stretch: 120%;
    letter-spacing: -0.01em;
  }
  .plan-price {
    margin-top: 0.4rem;
    font-size: var(--step-2);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--color-brand-dark);
  }
  .plan-time {
    margin-top: 0.3rem;
    font-size: 1rem;
    color: var(--color-muted);
  }
  .plan-for {
    max-width: 40rem;
    font-weight: 600;
  }
  .plan-list {
    max-width: 40rem;
    margin-top: 0.75rem;
    padding-left: 1.2rem;
    list-style: disc;
    color: var(--color-muted);
  }
  .plan-list li {
    margin-bottom: 0.3rem;
  }
  .plan-list li::marker {
    color: var(--color-brand);
  }
  .plans-note {
    margin-top: 1rem;
    font-size: 1rem;
    color: var(--color-muted);
  }

  @media (max-width: 44rem) {
    .plan {
      grid-template-columns: 1fr;
    }
  }
</style>
