---
// Two demo-site slots (playbook section 7, week 1): one per target niche, for made-up
// businesses, always labeled "Demo". With no url yet, a slot says honestly that the demo
// is in progress. Add url, image, imageAlt and pageSpeed in site.ts when a demo is live.
import { Image } from 'astro:assets';
import { offer } from '../../content/site';

const { heading, lede, slots } = offer.demos;
---

<section id="demos" class="section pt-0" aria-labelledby="demos-title">
  <div class="wrap">
    <h2 id="demos-title">{heading}</h2>
    <p class="section-lede">{lede}</p>
    <ul class="demos">
      {
        slots.map((slot) => (
          <li class:list={['demo', { 'demo-pending': !slot.url }]}>
            {slot.url && slot.image ? (
              <div
                class="demo-frame demo-window"
                tabindex="0"
                role="region"
                aria-label={`${slot.title} homepage preview, scrollable`}
              >
                <Image
                  src={slot.image}
                  alt={slot.imageAlt ?? ''}
                  widths={[480, 800, 1040]}
                  sizes="(min-width: 72rem) 32rem, (min-width: 48rem) 45vw, 100vw"
                  quality={70}
                  class="demo-shot"
                />
              </div>
            ) : (
              <div class="demo-frame">
                <p class="demo-placeholder">Screenshot coming soon</p>
              </div>
            )}
            <p class="demo-label">Demo site for {slot.niche.toLowerCase()}</p>
            <h3 class="demo-title">{slot.title}</h3>
            {slot.url ? (
              <>
                {slot.pageSpeed !== undefined && <p class="demo-score">Mobile PageSpeed score: {slot.pageSpeed}</p>}
                <p class="demo-link">
                  <a href={slot.url}>
                    View the {slot.title.replace(/^Demo:\s*/, '')} demo
                  </a>
                </p>
              </>
            ) : (
              <p class="demo-status">In progress. Ask me for a preview on your free call.</p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .demos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2.5rem 3rem;
    margin-top: 3rem;
    padding: 0;
    list-style: none;
  }
  .demo-frame {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  .demo-pending .demo-frame {
    border: 2px dashed var(--color-line);
    background: transparent;
  }
  /* A live demo's frame is a small window onto its whole homepage. The page scrolls past it
     as usual; scrolling with the pointer or a finger on it scrolls the demo, and at either end
     the scroll carries on to the page. Keyboard users can tab to it and use the arrow keys. */
  .demo-window {
    display: block;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-brand) transparent;
  }
  .demo-shot {
    display: block;
    width: 100%;
    height: auto;
  }
  .demo-placeholder {
    color: var(--color-muted);
    font-weight: 600;
  }
  .demo-label {
    margin-top: 1.1rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-brand-dark);
  }
  /* Balanced lines split the business name on phones ("Demo: Purple / Martin Heating & Air") */
  .demo-title {
    margin-top: 0.2rem;
    text-wrap: pretty;
  }
  .demo-status,
  .demo-score {
    margin-top: 0.4rem;
    color: var(--color-muted);
  }
  .demo-link {
    margin-top: 0.5rem;
    font-weight: 650;
  }
</style>
