---
// Trinity Web Co. hero: the line drawing of the Trinity River with Dallas neighborhoods
// along it. The page's one memorable moment; it draws itself once on load, then a darker
// current runs along it as the page scrolls.
import { site } from '../../content/site';

const { headline, lede, primaryCta, secondaryCta } = site.hero;
const path =
  'M-30 120 C40 130 80 86 140 88 S280 172 355 168 S440 62 500 64 S640 182 720 178 S810 98 870 96 S1000 156 1070 152 S1170 110 1240 118';
// Points sit on the path's segment ends; labels go above peaks and below troughs.
const stops = [
  { name: 'West Dallas', x: 140, y: 88, labelY: 56 },
  { name: 'Oak Cliff', x: 355, y: 168, labelY: 212, hideOnPhone: true },
  { name: 'Trinity Groves', x: 500, y: 64, labelY: 32 },
  { name: 'Bishop Arts', x: 720, y: 178, labelY: 224 },
  { name: 'Design District', x: 870, y: 96, labelY: 64, hideOnPhone: true },
  { name: 'Deep Ellum', x: 1070, y: 152, labelY: 196 },
];
// How far along `path` each stop sits (0 to 1), so its dot fills as the scroll current reaches
// it. Kept out of `stops`, whose exact shape the Instagram kit's `npm run sync` reads.
// shortcut: measured once from the paths; measure again (and `at` below) if a path changes.
const stopsAt = [0.124, 0.29, 0.422, 0.601, 0.726, 0.876];
// Wide screens: the same river turned 26° to run up the hero's right half, with labels
// beside each stop (left of peaks, right of troughs) so they stay level and clear of the line.
// It starts at the West Dallas dot and leaves through the right edge of the screen.
const widePath =
  'M170 300 C206 283 277 310 321 286 S340 198 377 182 S494 212 540 186 S570 113 605 94 S700 92 740 69 S820 40 870 34 S940 30 990 22';
const wideStops = [
  { name: 'West Dallas', x: 170, y: 300, peak: true, at: 0 },
  { name: 'Oak Cliff', x: 321, y: 286, at: 0.161 },
  { name: 'Trinity Groves', x: 377, y: 182, peak: true, at: 0.29 },
  { name: 'Bishop Arts', x: 540, y: 186, at: 0.464 },
  { name: 'Design District', x: 605, y: 94, peak: true, at: 0.586 },
  { name: 'Deep Ellum', x: 740, y: 69, at: 0.731 },
];
---

<section class="hero">
  <div class="wrap hero-grid">
    <h1 class="hero-title">{headline}</h1>
    <div class="hero-copy">
      <p class="hero-lede">{lede}</p>
      <div class="hero-actions" data-book-cta>
        <a class="btn btn-primary btn-arrow" href={primaryCta.href}>{primaryCta.label}</a>
        {secondaryCta && <a class="btn btn-secondary" href={secondaryCta.href}>{secondaryCta.label}</a>}
      </div>
    </div>

    <div class="river river-wide" aria-hidden="true">
      <svg class="river-svg" viewBox="-10 0 930 330" preserveAspectRatio="xMinYMid meet">
        <path class="river-bank" d={widePath}></path>
        <path class="river-line" pathLength="1" d={widePath}></path>
        <path class="river-current" pathLength="1" d={widePath}></path>
        <g class="river-stops">
          {
            wideStops.map((stop, i) => (
              <g style={`--i:${i};--at:${stop.at}`}>
                <circle cx={stop.x} cy={stop.y} r="8"></circle>
                <text
                  x={stop.peak ? stop.x - 16 : stop.x + 16}
                  y={stop.peak ? stop.y - 14 : stop.y + 30}
                  text-anchor={stop.peak ? 'end' : 'start'}
                >
                  {stop.name}
                </text>
              </g>
            ))
          }
        </g>
      </svg>
    </div>
  </div>

  <div class="river river-strip" aria-hidden="true">
    <svg class="river-svg" viewBox="0 0 1200 240" preserveAspectRatio="xMidYMid meet">
      <path class="river-bank" d={path}></path>
      <path class="river-line" pathLength="1" d={path}></path>
      <path class="river-current" pathLength="1" d={path}></path>
      <g class="river-stops">
        {
          stops.map((stop, i) => (
            <g style={`--i:${i};--at:${stopsAt[i]}`} class:list={{ 'hide-on-phone': stop.hideOnPhone }}>
              <circle cx={stop.x} cy={stop.y} r="8"></circle>
              <text x={stop.x} y={stop.labelY}>{stop.name}</text>
            </g>
          ))
        }
      </g>
    </svg>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    overflow: hidden;
  }
  .hero-title {
    max-width: 15ch;
  }
  .hero-lede {
    max-width: 38rem;
    margin-top: 1.75rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--color-muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .river-strip {
    max-width: 90rem;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    padding-bottom: 1rem;
  }
  .river-wide {
    display: none;
  }

  /* Wide screens: headline across the top, then the copy beside the river, which runs off the right edge */
  @media (min-width: 75rem) {
    .hero {
      padding-bottom: 1rem;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(0, 7fr);
      column-gap: 2.5rem;
      align-items: start;
    }
    .hero-title {
      grid-column: 1 / -1;
      max-width: none;
    }
    .river-wide {
      display: block;
      margin-top: 1rem;
      /* bleed past the wrap's padding and side margin to the viewport edge */
      margin-right: calc(-1 * (max(0px, (100vw - 72rem) / 2) + 2.5rem));
    }
    .river-wide .river-svg {
      overflow: hidden;
    }
    .river-wide .river-stops text {
      font-size: 22px;
    }
    .river-strip {
      display: none;
    }
  }
  .river-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .river-bank {
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 30;
    stroke-linecap: round;
    opacity: 0.12;
  }
  .river-line {
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  /* The scroll current (see "Scrolling" below): river deep, a little wider so it covers the line */
  .river-current {
    display: none;
    fill: none;
    stroke: var(--color-brand-dark);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  /* Paper dots with an ink ring, like the Instagram kit: gold is for primary buttons only */
  .river-stops circle {
    fill: var(--color-surface);
    stroke: var(--color-text);
    stroke-width: 2.5;
  }
  .river-stops text {
    fill: var(--color-text);
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 650;
    font-stretch: 110%;
  }
  .river-strip text {
    text-anchor: middle;
  }

  @media (prefers-reduced-motion: no-preference) {
    .river-line {
      stroke-dashoffset: 1;
      animation: river-draw 2.2s cubic-bezier(0.45, 0.05, 0.25, 1) 0.2s forwards;
    }
    .river-stops g {
      opacity: 0;
      animation: stop-in 0.45s ease-out forwards;
      animation-delay: calc(0.55s + var(--i) * 0.3s);
    }
  }
  @keyframes river-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes stop-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* On phones, show the middle stretch of the river at a readable size */
  @media (max-width: 40rem) {
    .river-strip {
      --strip-w: 860px;
      display: flex;
      justify-content: center;
    }
    .river-strip .river-svg {
      width: var(--strip-w);
      max-width: none;
      flex: none;
    }
    /* These two labels fall off the screen edges at this width, unless the river slides (below) */
    .hide-on-phone text {
      display: none;
    }
  }

  /* Scrolling: as the hero scrolls away, the current runs down the river from West Dallas and
     each dot fills in as the current reaches it (its --at); scrolling back up runs it back. It
     finishes --flow-end of the way through the hero leaving the screen, while the river is still
     in view. Browsers without scroll-driven animations, and anyone who prefers reduced motion,
     keep the river as drawn on load. Each timeline sits in its own rule, as in Process.astro:
     the CSS minifier folds it into the animation shorthand, which browsers reject. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero {
        --flow-end: 60%;
        view-timeline: --hero;
      }
      /* The wide hero is shorter, so its river reaches the header sooner */
      @media (min-width: 75rem) {
        .hero {
          --flow-end: 40%;
        }
      }
      /* Measured against the whole screen rather than the page's 5rem anchor padding, so
         nothing moves before the first scroll */
      section.hero {
        view-timeline-inset: 0;
      }
      .river-current {
        display: inline;
        animation: river-draw linear both;
      }
      .river-svg .river-current {
        animation-timeline: --hero;
        animation-range: exit 0% exit var(--flow-end);
      }
      .river-stops circle {
        animation: stop-reached linear both;
      }
      .river-stops g circle {
        animation-timeline: --hero;
        animation-range: exit calc(var(--at) * var(--flow-end)) exit calc(var(--at) * var(--flow-end) + 2%);
      }

      /* Phones: the river also slides from West Dallas to Deep Ellum, so all six stops pass by */
      @media (max-width: 40rem) {
        .river-strip .river-svg {
          animation: river-pan linear both;
        }
        .river-strip > .river-svg {
          animation-timeline: --hero;
          animation-range: exit 0% exit var(--flow-end);
        }
        .river-strip .hide-on-phone text {
          display: inline;
        }
      }
    }
  }
  @keyframes stop-reached {
    to {
      fill: var(--color-brand);
    }
  }
  @keyframes river-pan {
    from {
      transform: translateX(calc((var(--strip-w) - 100vw) / 2));
    }
    to {
      transform: translateX(calc((100vw - var(--strip-w)) / 2));
    }
  }
</style>
