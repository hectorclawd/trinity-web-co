---
// The How it works clip: a drawn phone runs through the five steps as you scroll; it never plays
// on its own. With motion on, the section pins (Process.astro): the page holds still while the
// scroll plays the clip and marks the step it shows, then the page moves on. Made with the
// Instagram kit (business/marketing/instagram/site-build/, see HANDOFF.md), encoded with a
// keyframe every 2 frames so seeking stays smooth. The scrub follows the scroll-craft skill's
// engine: the clip runs across the stage's whole time on screen with a settle in the middle, the
// playhead eases toward the scroll, seeks are rate-limited, and the poster holds until a real
// frame has painted. Screen readers skip it: the steps beside it already say everything it
// shows. With reduced motion or without JavaScript it shows its poster, the finished state, and
// the video never downloads.
---

<div class="build-clip" data-build-clip>
  <video
    src="/media/build-clip.mp4"
    poster="/media/build-clip-poster.webp"
    width="628"
    height="1166"
    muted
    playsinline
    disablepictureinpicture
    preload="none"
    aria-hidden="true"
    tabindex="-1"
  ></video>
  <img class="build-clip-poster" src="/media/build-clip-poster.webp" width="628" height="1166" alt="" />
</div>

<style>
  .build-clip {
    position: relative;
    width: min(100%, 22rem);
    margin: 2.5rem auto 0;
  }
  .build-clip video {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Holds the frame until the video has painted one: iPhones show a seeked but never-played
     video as blank */
  .build-clip-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.2s;
  }
  .build-clip.has-frame .build-clip-poster {
    opacity: 0;
  }
  /* Wide screens: the clip stays in view beside the steps while they scroll past */
  @media (min-width: 68rem) {
    .build-clip {
      position: sticky;
      top: 6rem;
      width: 100%;
      margin: 0;
    }
  }
  /* Pinned (see Process.astro): the whole stage holds still, so the clip sizes to its height,
     leaving room under it on phones for the step it is showing */
  :global(.process.is-pinned) .build-clip {
    position: relative;
    width: fit-content;
    margin: 0 auto;
  }
  :global(.process.is-pinned) .build-clip video {
    width: auto;
    height: max(15rem, calc(var(--stage-h) - 12rem));
  }
  @media (min-width: 68rem) {
    :global(.process.is-pinned) .build-clip video {
      height: min(41rem, calc(var(--stage-h) - 3rem));
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-build-clip]');
  const video = root?.querySelector('video');
  const section = document.getElementById('process');
  const steps = document.querySelector<HTMLElement>('#process .steps');
  const track = document.querySelector<HTMLElement>('[data-process-track]');
  const stage = track?.firstElementChild as HTMLElement | null;

  if (root && video && section && steps && track && stage && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = [...steps.children];
    // Pin only where the stage fits: not on a phone turned sideways or a very short window
    const tallEnough = window.matchMedia('(min-height: 34rem)');
    const setPinned = () => section.classList.toggle('is-pinned', tallEnough.matches);
    setPinned();
    tallEnough.addEventListener('change', setPinned);

    // scroll-craft's dwell remap: quick at the edges, a settle in the middle. 0.35 lands the
    // fast part on the slides in and out and the slow part inside the pin.
    const DWELL = 0.35;
    const dwell = (x: number) => (1 - DWELL) * x + DWELL * (4 * (x - 0.5) ** 3 + 0.5);
    const clamp01 = (x: number) => Math.min(1, Math.max(0, x));

    // Pinned: the clip runs across the stage's whole time on screen, from the moment the track
    // enters at the bottom to the moment the stage leaves under the header, so it never sits
    // frozen while the page slides it in or out. Otherwise, beside the steps (wide screens) the
    // clip follows the reader down the list; above them (phones), it plays as it crosses the screen.
    const progress = () => {
      const vh = window.innerHeight;
      if (section.classList.contains('is-pinned')) {
        const t = track.getBoundingClientRect();
        const pinTop = parseFloat(getComputedStyle(stage).top) || 0;
        return dwell(clamp01((vh - t.top) / (t.height + vh - pinTop)));
      }
      if (getComputedStyle(root).position === 'sticky') {
        const r = steps.getBoundingClientRect();
        return clamp01((vh * 0.55 - r.top) / r.height);
      }
      const r = root.getBoundingClientRect();
      return clamp01((vh - r.top) / (vh + r.height));
    };

    // Scroll only sets a target; the step on screen follows it straight away
    let target = 0;
    let queued = false;
    const read = () => {
      queued = false;
      target = progress();
      // The clip gives each step an equal share, so the step on screen is the matching slice
      const current = Math.min(items.length - 1, Math.floor(target * items.length));
      items.forEach((item, i) => {
        item.classList.toggle('is-active', i === current);
        item.classList.toggle('is-done', i < current);
      });
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(read);
    };

    // The playhead eases toward the target (18% of the gap per frame), so a trackpad flick
    // glides. A seek smaller than the deadband shows nothing and costs a phone a decode, and no
    // seek is asked for while the last one is still resolving (one stuck past 700ms is re-sent).
    const EASE = 0.18;
    const DEADBAND = window.matchMedia('(pointer: coarse)').matches ? 0.02 : 0.008;
    let shown = 0;
    let stuckSince = 0;
    const tick = () => {
      requestAnimationFrame(tick);
      if (!(video.duration > 0)) return;
      if (video.seeking) {
        const now = performance.now();
        if (!stuckSince) stuckSince = now;
        else if (now - stuckSince > 700) {
          stuckSince = now;
          video.currentTime += 0.001;
        }
        return;
      }
      stuckSince = 0;
      if (Math.abs(target - shown) < 0.0005) return;
      shown += (target - shown) * EASE;
      const time = shown * (video.duration - 0.05);
      if (Math.abs(video.currentTime - time) > DEADBAND) video.currentTime = time;
    };

    // iPhones decode a muted video only after play(); a muted play is allowed, and it pauses at
    // once. In Low Power Mode it isn't, so the reader's first touch tries again.
    const prime = () =>
      video
        .play()
        .then(() => video.pause())
        .catch(() => {});
    window.addEventListener('pointerdown', prime, { once: true, passive: true });
    // The poster lifts once a real frame is up, or after 2.5s in case a seek never reports back
    const reveal = () => root.classList.add('has-frame');
    video.addEventListener(
      'loadedmetadata',
      () => {
        video.currentTime = Math.max(shown * video.duration, 0.001);
        video.addEventListener('seeked', reveal, { once: true });
        setTimeout(reveal, 2500);
        requestAnimationFrame(tick);
      },
      { once: true },
    );

    // Load the video only when How it works is close. It comes down whole, as scroll-craft does,
    // so every seek is local (Safari seeks a streamed video slowly); if that fails, it streams.
    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        const file = video.currentSrc || video.src;
        const stream = () => {
          video.src = file;
          video.preload = 'auto';
          video.load();
          prime();
        };
        fetch(file)
          .then((response) => {
            if (!response.ok) throw new Error(String(response.status));
            return response.blob();
          })
          .then((blob) => {
            // If the browser refuses the local copy, stream the file instead
            video.addEventListener('error', stream, { once: true });
            video.preload = 'auto';
            video.src = URL.createObjectURL(blob);
            prime();
          })
          .catch(stream);
      },
      { rootMargin: '800px 0px' },
    ).observe(root);
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    queue();
  }
</script>
