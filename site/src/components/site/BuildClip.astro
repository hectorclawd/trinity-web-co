---
// The How it works clip: a drawn phone runs through the five steps as you scroll; it never plays
// on its own. With motion on, the section pins (Process.astro): the page holds still while the
// scroll plays the clip and marks the step it shows, then the page moves on. Made with the Instagram kit (business/marketing/instagram/site-build/, see
// HANDOFF.md), encoded with a keyframe every 2 frames so seeking stays smooth. Screen readers
// skip it: the steps beside it already say everything it shows. With reduced motion or without
// JavaScript it shows its poster, the finished state, and the video never downloads.
---

<div class="build-clip" data-build-clip>
  <video
    src="/media/build-clip.mp4"
    poster="/media/build-clip-poster.webp"
    width="628"
    height="1166"
    muted
    playsinline
    disablepictureinpicture
    preload="none"
    aria-hidden="true"
    tabindex="-1"
  ></video>
</div>

<style>
  .build-clip {
    width: min(100%, 22rem);
    margin: 2.5rem auto 0;
  }
  .build-clip video {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Wide screens: the clip stays in view beside the steps while they scroll past */
  @media (min-width: 68rem) {
    .build-clip {
      position: sticky;
      top: 6rem;
      width: 100%;
      margin: 0;
    }
  }
  /* Pinned (see Process.astro): the whole stage holds still, so the clip sizes to its height,
     leaving room under it on phones for the step it is showing */
  :global(.process.is-pinned) .build-clip {
    position: static;
    width: auto;
    margin: 0 auto;
  }
  :global(.process.is-pinned) .build-clip video {
    width: auto;
    height: max(15rem, calc(var(--stage-h) - 12rem));
  }
  @media (min-width: 68rem) {
    :global(.process.is-pinned) .build-clip video {
      height: min(41rem, calc(var(--stage-h) - 3rem));
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-build-clip]');
  const video = root?.querySelector('video');
  const section = document.getElementById('process');
  const steps = document.querySelector<HTMLElement>('#process .steps');
  const track = document.querySelector<HTMLElement>('[data-process-track]');
  const stage = track?.firstElementChild as HTMLElement | null;

  if (root && video && section && steps && track && stage && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ready = false;
    let queued = false;
    const items = [...steps.children];
    // Pin only where the stage fits: not on a phone turned sideways or a very short window
    const tallEnough = window.matchMedia('(min-height: 34rem)');
    const setPinned = () => section.classList.toggle('is-pinned', tallEnough.matches);
    setPinned();
    tallEnough.addEventListener('change', setPinned);

    // Pinned: how far the stage has stuck through the track. Otherwise, beside the steps (wide
    // screens) the clip follows the reader down the list; above them (phones), it plays as the
    // clip itself crosses the screen.
    const progress = () => {
      const vh = window.innerHeight;
      if (section.classList.contains('is-pinned')) {
        const t = track.getBoundingClientRect();
        const s = stage.getBoundingClientRect();
        return (s.top - t.top) / (t.height - s.height);
      }
      if (getComputedStyle(root).position === 'sticky') {
        const r = steps.getBoundingClientRect();
        return (vh * 0.55 - r.top) / r.height;
      }
      const r = root.getBoundingClientRect();
      return (vh - r.top) / (vh + r.height);
    };
    // The playhead eases toward the scroll position (scroll-craft's scrub smoothing: 18% of the
    // gap per frame), so a trackpad flick glides instead of jumping frames
    const EASE = 0.18;
    let shown = 0;
    const update = () => {
      queued = false;
      const p = Math.min(1, Math.max(0, progress()));
      // The clip gives each step an equal share, so the step on screen is the matching slice
      const current = Math.min(items.length - 1, Math.floor(p * items.length));
      items.forEach((item, i) => {
        item.classList.toggle('is-active', i === current);
        item.classList.toggle('is-done', i < current);
      });
      if (!ready) return;
      const target = p * (video.duration - 0.05);
      shown += (target - shown) * EASE;
      if (Math.abs(target - shown) < 0.01) shown = target;
      else queue();
      if (Math.abs(video.currentTime - shown) > 0.02) video.currentTime = shown;
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    video.addEventListener(
      'loadedmetadata',
      () => {
        ready = true;
        queue();
      },
      { once: true },
    );
    // iPhones decode a muted video only after play(); a muted play is allowed, and it pauses at once
    const prime = () =>
      video
        .play()
        .then(() => video.pause())
        .catch(() => {});
    // Load the video only when How it works is close. It comes down whole, as scroll-craft does,
    // so every seek is local (Safari seeks a streamed video slowly); if that fails, it streams.
    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        const file = video.currentSrc || video.src;
        const stream = () => {
          video.src = file;
          video.preload = 'auto';
          video.load();
          prime();
        };
        fetch(file)
          .then((response) => {
            if (!response.ok) throw new Error(String(response.status));
            return response.blob();
          })
          .then((blob) => {
            // If the browser refuses the local copy, stream the file instead
            video.addEventListener('error', stream, { once: true });
            video.src = URL.createObjectURL(blob);
            prime();
          })
          .catch(stream);
      },
      { rootMargin: '800px 0px' },
    ).observe(root);
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    queue();
  }
</script>
