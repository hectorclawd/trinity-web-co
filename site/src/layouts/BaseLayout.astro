---
// Every page uses this layout: meta tags, Open Graph, LocalBusiness schema, analytics.
import '../styles/site.css';
// Same hashed file the CSS loads; preloading it stops the hero text reflowing when Archivo swaps in
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/site/SiteHeader.astro';
import Footer from '../components/site/SiteFooter.astro';
import { site } from '../content/site';
import { localBusinessSchema } from '../lib/format';

interface Props {
  /** Page title without the business name; omit on the homepage */
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description = site.seo.description, ogImage = site.seo.ogImage, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.seo.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
const schema = localBusinessSchema(site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={site.seo.ogImageAlt ?? site.name} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>

<script>
  // Call, text and form tracking (custom events need Vercel Pro, which client sites are on)
  import { track } from '@vercel/analytics';

  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest('a[href^="tel:"], a[href^="sms:"], a[href^="https://cal.com/"]');
    if (!link) return;
    const href = link.getAttribute('href')!;
    track(href.startsWith('tel:') ? 'Call click' : href.startsWith('sms:') ? 'Text click' : 'Booking click');
  });
  document.addEventListener('contact-form:sent', () => track('Form submit'));
</script>

<script>
  // Smooth scrolling starts once the page has loaded (see site.css), so arriving at /services/#care
  // from another page jumps straight to the section
  const smooth = () => document.documentElement.classList.add('smooth-scroll');
  if (document.readyState === 'complete') smooth();
  else addEventListener('load', smooth, { once: true });
</script>

<script>
  // Menu button, header shadow, hero headline words, cards rising on scroll and counters
  const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  menuBtn?.addEventListener('click', () => {
    const open = nav!.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', String(open));
  });

  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Words fade up one after another; the h1 keeps its text for screen readers
  const h1 = document.querySelector('.hero h1');
  if (h1?.textContent) {
    const words = h1.textContent.trim().split(/\s+/);
    h1.textContent = '';
    words.forEach((word, i) => {
      const span = document.createElement('span');
      span.className = 'w';
      span.style.setProperty('--i', String(i));
      span.textContent = word;
      h1.append(span, i < words.length - 1 ? ' ' : '');
    });
  }

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const countUp = (el: HTMLElement) => {
    const end = Number(el.dataset.count);
    const suffix = el.dataset.suffix ?? '';
    if (reduced) return;
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / 1200);
      el.textContent = Math.round(end * (1 - Math.pow(1 - t, 3))) + suffix;
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        el.classList.add('in');
        if (el.dataset.count) countUp(el);
        io.unobserve(el);
      }),
    { threshold: 0.15 },
  );
  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
    el.classList.add('reveal');
    io.observe(el);
  });
  document.querySelectorAll('[data-count], [data-draw]').forEach((el) => io.observe(el));

  // Phones: the bottom booking bar waits until the page's own booking buttons have scrolled away
  const floatBar = document.querySelector<HTMLElement>('.float-bar');
  const pageCta = document.querySelector('.hero-actions, .page-head .actions');
  if (floatBar && pageCta) {
    floatBar.classList.add('away');
    new IntersectionObserver(([entry]) =>
      floatBar.classList.toggle('away', entry.isIntersecting || entry.boundingClientRect.top > 0),
    ).observe(pageCta);
  }

  // Tagline: each word lights up in reading order as the line moves up the screen
  const tagline = document.querySelector<HTMLElement>('[data-tagline]');
  if (tagline?.textContent && !reduced) {
    const words = tagline.textContent.trim().split(/\s+/);
    tagline.textContent = '';
    const spans = words.map((word, i) => {
      const span = document.createElement('span');
      span.className = 'tw';
      span.textContent = word;
      tagline.append(span, i < words.length - 1 ? ' ' : '');
      return span;
    });
    let queued = false;
    const light = () => {
      queued = false;
      const box = tagline.getBoundingClientRect();
      // 0 when the line's top reaches 85% down the screen, 1 when its bottom passes 45%
      const progress = (innerHeight * 0.85 - box.top) / (box.height + innerHeight * 0.4);
      const lit = Math.round(Math.min(1, Math.max(0, progress)) * spans.length);
      spans.forEach((span, i) => span.classList.toggle('on', i < lit));
    };
    addEventListener('scroll', () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(light);
      }
    }, { passive: true });
    light();
  }
</script>
